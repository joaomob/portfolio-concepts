---
// The cart drawer. The item list, subtotal, shipping and total are filled in by scripts/cart.ts from localStorage.
// The "Ship to" list and the two cost lines were added by the original store.js at runtime; here they are rendered.
import { SHIP_COUNTRIES } from '../data/shipping';

interface Props {
  /** the small note under the checkout button (the home and the info pages show it) */
  note?: boolean;
}
const { note = false } = Astro.props;
---
<div class="cart-drawer_component" id="cart" aria-hidden="true">
  <div class="cart-drawer_overlay"></div>
  <aside class="cart-drawer_panel" role="dialog" aria-modal="true" aria-label="Cart">
    <div class="cart-drawer_header"><div class="heading-style-h3">Your Cart</div><button class="cart-drawer_close">Close</button></div>
    <div class="cart-drawer_items" id="cart-items"></div>
    <div class="cart-drawer_footer">
      <label class="cart-drawer_shipping"><span class="cart-drawer_shipping-label">Ship to</span><select class="cart-drawer_select" id="ship-country">{SHIP_COUNTRIES.map((c) => <option value={c.code}>{c.name}</option>)}</select></label>
      <div class="cart-drawer_line"><span>Subtotal</span><span id="cart-subtotal">-</span></div>
      <div class="cart-drawer_line"><span>Shipping</span><span id="cart-ship">-</span></div>
      <div class="cart-drawer_total"><span>Total</span><span id="cart-total">€0</span></div>
      <button class="button is-gold is-full" id="checkout-btn" disabled>Proceed to Checkout</button>
      <p class="cart-drawer_status" id="checkout-status" role="status" aria-live="polite"></p>
      {note && <p class="cart-drawer_note">VAT calculated at checkout. Home pickup, tracked.</p>}
    </div>
  </aside>
</div>
