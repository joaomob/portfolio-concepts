---
// The page shown after a paid checkout.
import { ASTRO_BASE, page } from '../../lib/site';
---
<section class="section_success theme-inverse">
  <div class="success_glow"></div>
  <div class="padding-global"><div class="container-small"><div class="success_content">
    <p class="text-style-eyebrow">Order received</p>
    <h1 class="heading-style-h2 text-color-marble">Thank you.</h1>
    <p class="success_text">Your Arcanum is being prepared and hand-finished. A confirmation is on its way to your inbox.</p>
    <a class="button is-gold" href={page(ASTRO_BASE, 'collection')}>Continue the collection</a>
  </div></div></div>
</section>
