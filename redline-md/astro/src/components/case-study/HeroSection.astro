---
// Case study section: Redline MD, a landing page built for Google Ads
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-hero" data-pane="case-study">
      <div class="section-frame is-top"><div class="section-card is-page-hero">
        <div class="padding-global padding-section-small"><div class="container-large">
          <div class="page-hero_content" data-anim="">
            <div class="tag"><span class="tag_dot"></span>Case study</div>
            <h1 class="heading-style-h2">Redline MD, a landing page built for Google Ads</h1>
            <div class="max-width-medium"><p class="text-size-large text-style-balance text-color-secondary">The goal is to turn ad clicks into contract uploads. 35% of the traffic is mobile, and mobile brings less than 10% of the revenue.</p></div>
            <div class="page-hero_tags"><span class="pill is-gray">Mobile-first</span><span class="pill is-gray">Webflow</span><span class="pill is-gray">Client-First</span><span class="pill is-gray">Finsweet</span></div>
          </div>
          <div class="case-study_compare" data-anim-group="">
            <div class="case-study_shot"><img class="case-study_shot-image" loading="eager" src={asset('cs/before-rl-d-1.webp')} alt="The current Redline MD site" width="1440" height="900"><span class="case-study_label">Before</span></div>
            <div class="case-study_shot"><img class="case-study_shot-image" loading="eager" src={asset('cs/after-hero-d.webp')} alt="The new Redline MD landing page" width="1600" height="1000"><span class="case-study_label is-after">After</span></div>
          </div>
        </div></div>
      </div></div>
    </section>
