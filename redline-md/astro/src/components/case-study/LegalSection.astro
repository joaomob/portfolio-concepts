---
// Case study section: Everything stays on the page
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-legal" data-pane="case-study">
      <div class="padding-global padding-section-medium"><div class="container-large">
        <div class="case-study_block">
          <div class="case-study_block-content" data-anim="">
            <span class="text-style-eyebrow text-color-brand">11 · Legal and footer</span>
            <h2 class="heading-style-h3">Everything stays on the page</h2>
            <div class="case-study_list">
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>Terms, privacy and cookie policies open as modals</div>
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>Each one has its own URL, like /#privacy-policy, that opens the policy directly, ready for app stores, ad platforms and anyone who asks for the link</div>
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>Cookie preferences can change any time from the footer</div>
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>A full footer with product links, legal pages, contact and a disclaimer</div>
            </div>
          </div>
          <div class="case-study_block-media is-stack" data-anim-group="">
            <div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/legal-d.webp')} alt="Privacy Policy opened from its own link" width="1600" height="1000"></div>
            <div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/footer-d.webp')} alt="New footer" width="1600" height="496"></div>
          </div>
        </div>
      </div></div>
    </section>
