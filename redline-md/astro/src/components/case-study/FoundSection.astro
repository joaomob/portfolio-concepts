---
// Case study section: A site that made physicians doubt it
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-found" data-pane="case-study">
      <div class="padding-global padding-section-medium"><div class="container-large">
        <div class="case-study_block">
          <div class="case-study_block-content" data-anim="">
            <span class="text-style-eyebrow text-color-brand">01 · What I found</span>
            <h2 class="heading-style-h3">A site that made physicians doubt it</h2>
            <div class="case-study_issues">
              <div class="case-study_issue"><span class="case-study_issue-icon">✕</span>A typo in the logo: "Medical Contract Reiew"</div>
              <div class="case-study_issue"><span class="case-study_issue-icon">✕</span>Savings of $50,000, $10,000 and $6,000 in different sections, and a salary counter stuck at 0%</div>
              <div class="case-study_issue"><span class="case-study_issue-icon">✕</span>Blurry, invented product screens</div>
              <div class="case-study_issue"><span class="case-study_issue-icon">✕</span>The sample report was a Google Drive link</div>
              <div class="case-study_issue"><span class="case-study_issue-icon">✕</span>$199 never shown next to the $500 lawyer, and the $10,000 risk buried mid-page</div>
              <div class="case-study_issue"><span class="case-study_issue-icon">✕</span>On mobile, a cookie banner covering a third of the screen and no fixed CTA</div>
              <div class="case-study_issue"><span class="case-study_issue-icon">✕</span>A footer with only the name and the copyright</div>
            </div>
          </div>
          <div class="case-study_block-media is-pair" data-anim-group="">
            <div class="case-study_phone"><img class="case-study_shot-image" src={asset('cs/before-rl-m-1.webp')} alt="The current site on mobile, with the cookie banner" width="780" height="1688"></div>
            <div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/before-rl-d-5.webp')} alt="The current site footer" width="1440" height="900"><span class="case-study_label">Before</span></div>
          </div>
        </div>
      </div></div>
    </section>
