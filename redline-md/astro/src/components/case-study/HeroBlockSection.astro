---
// Case study section: The ROI before the scroll
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-hero-block" data-pane="case-study">
      <div class="section-frame"><div class="section-card">
        <div class="padding-global padding-section-medium"><div class="container-large">
          <div class="case-study_block is-reverse">
            <div class="case-study_block-content" data-anim="">
              <span class="text-style-eyebrow text-color-brand">02 · Hero</span>
              <h2 class="heading-style-h3">The ROI before the scroll</h2>
              <div class="case-study_list">
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>A headline about money and timing: "Know what your contract costs before you sign."</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>The price inside the button, and "$500 or more" right under it</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>Physician photos in the brand colors next to contract cards drawn in code, so the page reads as medical in the first second</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>A full-screen hero on every device</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>Redline's own logo, with the tagline typo fixed from "Reiew" to "Review" using the letters of the original file</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>ISO 27001, SOC 2, AES-256 and GDPR right under the buttons</div>
              </div>
            </div>
            <div class="case-study_block-media is-first" data-anim=""><div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/after-hero-d.webp')} alt="New hero" width="1600" height="1000"></div></div>
          </div>
        </div></div>
      </div></div>
    </section>
