---
// Case study section: The cost, side by side
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-cost" data-pane="case-study">
      <div class="section-frame"><div class="section-card">
        <div class="padding-global padding-section-medium"><div class="container-large">
          <div class="case-study_block is-reverse">
            <div class="case-study_block-content" data-anim="">
              <span class="text-style-eyebrow text-color-brand">08 · Pricing</span>
              <h2 class="heading-style-h3">The cost, side by side</h2>
              <div class="case-study_list">
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>$199 vs. $480 to $1,950 at a contract firm vs. $10,000+ for a tail nobody negotiated</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>Firm prices from Contract Diagnostics' published packages</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>Redline in black with a green savings badge, and red kept for the risk</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>One product, one price, one CTA</div>
              </div>
            </div>
            <div class="case-study_block-media is-first" data-anim=""><div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/compare-d.webp')} alt="Cost comparison" width="1600" height="874"></div></div>
          </div>
        </div></div>
      </div></div>
    </section>
