---
// Case study section: Numbers that agree with each other
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-numbers" data-pane="case-study">
      <div class="padding-global padding-section-medium"><div class="container-large">
        <div class="case-study_block">
          <div class="case-study_block-content" data-anim="">
            <span class="text-style-eyebrow text-color-brand">03 · Proof</span>
            <h2 class="heading-style-h3">Numbers that agree with each other</h2>
            <div class="case-study_list">
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>Only figures from the brief and the current site</div>
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>The $10,000 risk counts up when it enters the screen</div>
            </div>
          </div>
          <div class="case-study_block-media" data-anim=""><div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/problem-d.webp')} alt="Problem section with the $10,000 card" width="1600" height="768"></div></div>
        </div>
      </div></div>
    </section>
