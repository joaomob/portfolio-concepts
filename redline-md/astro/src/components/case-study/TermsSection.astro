---
// Case study section: Six clauses, each with a source
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-terms" data-pane="case-study">
      <div class="padding-global padding-section-medium"><div class="container-large">
        <div class="case-study_block">
          <div class="case-study_block-content" data-anim="">
            <span class="text-style-eyebrow text-color-brand">07 · Clauses</span>
            <h2 class="heading-style-h3">Six clauses, each with a source</h2>
            <div class="case-study_list">
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>Validated against Med Contract Law's physician contract red flags and Redline's own report</div>
            </div>
          </div>
          <div class="case-study_block-media" data-anim=""><div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/terms-d.webp')} alt="Six clauses section" width="1600" height="924"></div></div>
        </div>
      </div></div>
    </section>
