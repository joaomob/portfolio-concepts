---
// Case study section: Trust before the payment
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-trust" data-pane="case-study">
      <div class="padding-global padding-section-medium"><div class="container-large">
        <div class="case-study_block">
          <div class="case-study_block-content" data-anim="">
            <span class="text-style-eyebrow text-color-brand">09 · Trust</span>
            <h2 class="heading-style-h3">Trust before the payment</h2>
            <div class="case-study_list">
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>Testimonials with photo, specialty and the result in numbers</div>
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>A physician founder with his own tail clause story</div>
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>A security section right after the price, where "is my contract safe?" is the last doubt before paying</div>
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>An FAQ that answers turnaround, security, refund and the lawyer question</div>
            </div>
          </div>
          <div class="case-study_block-media is-stack" data-anim-group=""><div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/security-d.webp')} alt="Security section" width="1600" height="752"></div><div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/founder-d.webp')} alt="Founder section" width="1600" height="810"></div></div>
        </div>
      </div></div>
    </section>
