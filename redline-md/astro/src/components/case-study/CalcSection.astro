---
// Case study section: A calculator anyone understands
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-calc" data-pane="case-study">
      <div class="section-frame"><div class="section-card">
        <div class="padding-global padding-section-medium"><div class="container-large">
          <div class="case-study_block is-reverse is-phone">
            <div class="case-study_block-content" data-anim="">
              <span class="text-style-eyebrow text-color-brand">06 · Calculator</span>
              <h2 class="heading-style-h3">A calculator anyone understands</h2>
              <div class="case-study_list">
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>The physician sets the malpractice premium and sees what tail coverage would cost</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>Based on AMA Insurance: tail can cost up to 2× the annual premium</div>
                <div class="case-study_list-item"><span class="case-study_list-dot"></span>The technical terms stay, because they're the words in the contract, and each one has a plain description and a tooltip</div>
              </div>
            </div>
            <div class="case-study_block-media is-first" data-anim=""><div class="case-study_phone is-single"><img class="case-study_shot-image" src={asset('cs/calc-m.webp')} alt="Calculator with tooltip on mobile" width="652" height="1398"></div></div>
          </div>
        </div></div>
      </div></div>
    </section>
