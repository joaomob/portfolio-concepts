---
// Case study section: Try it before you pay
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_case-study-demo" data-pane="case-study">
      <div class="padding-global padding-section-medium"><div class="container-large">
        <div class="case-study_block">
          <div class="case-study_block-content" data-anim="">
            <span class="text-style-eyebrow text-color-brand">05 · Demo</span>
            <h2 class="heading-style-h3">Try it before you pay</h2>
            <div class="case-study_list">
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>A sample contract with 4 flagged clauses</div>
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>Tap a flag to see the redline, with the original text struck through and the fix in green</div>
              <div class="case-study_list-item"><span class="case-study_list-dot"></span>Each clause reads as a full sentence before and after the redline</div>
            </div>
          </div>
          <div class="case-study_block-media" data-anim=""><div class="case-study_shot"><img class="case-study_shot-image" src={asset('cs/demo-d.webp')} alt="Interactive sample contract" width="1600" height="794"></div></div>
        </div>
      </div></div>
    </section>
