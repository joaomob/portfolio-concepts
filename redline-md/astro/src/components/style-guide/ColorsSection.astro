---
// Style guide section: Colors
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_style-guide-colors" data-pane="style-guide" id="sg-colors">
      <div class="padding-global padding-section-medium"><div class="container-large">
        <div class="heading_component is-narrow" data-anim=""><span class="text-style-eyebrow text-color-brand">01</span><h2 class="heading-style-h3">Colors</h2><p class="text-color-secondary">Black and white carry the page, red marks risk and the brand, blush warms the surfaces, and green only means savings.</p></div>
        <div class="style-guide_colors" data-anim-group="">
          <div class="style-guide_color"><div class="background-color-black"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Black</p><p class="style-guide_code">#0a0a0a · background-color-black</p><p class="style-guide_usage">Text, primary buttons, dark cards, footer</p></div></div>
          <div class="style-guide_color"><div class="background-color-white"><div class="style-guide_swatch is-ring"></div></div><div class="style-guide_color-info"><p class="style-guide_label">White</p><p class="style-guide_code">#ffffff · background-color-white</p><p class="style-guide_usage">Page, cards on gray, secondary buttons</p></div></div>
          <div class="style-guide_color"><div class="background-color-gray-50"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Gray 50</p><p class="style-guide_code">#f8f7f7 · background-color-gray-50</p><p class="style-guide_usage">Section cards, feature and testimonial cards</p></div></div>
          <div class="style-guide_color"><div class="background-color-gray-200"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Gray 200</p><p class="style-guide_code">#eeeeee · background-color-gray-200</p><p class="style-guide_usage">Borders, rings, gray pills, carousel arrows</p></div></div>
          <div class="style-guide_color"><div class="background-color-gray-300"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Gray 300</p><p class="style-guide_code">#d9d9d9 · background-color-gray-300</p><p class="style-guide_usage">Dots, dashed dropzone, text on black</p></div></div>
          <div class="style-guide_color"><div class="background-color-gray-500"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Gray 500</p><p class="style-guide_code">#9a9999 · background-color-gray-500</p><p class="style-guide_usage">Firm bar, labels on dark, sources</p></div></div>
          <div class="style-guide_color"><div class="background-color-gray-600"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Gray 600</p><p class="style-guide_code">#696868 · background-color-gray-600</p><p class="style-guide_usage">Body text, the Longevity text color</p></div></div>
          <div class="style-guide_color"><div class="background-color-gray-900"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Gray 900</p><p class="style-guide_code">#272727 · background-color-gray-900</p><p class="style-guide_usage">Borders and tracks on dark cards</p></div></div>
          <div class="style-guide_color"><div class="background-color-red"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Red</p><p class="style-guide_code">#de332f · background-color-red</p><p class="style-guide_usage">Brand, accent button, risk bar, button hover</p></div></div>
          <div class="style-guide_color"><div class="background-color-red-light"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Red light</p><p class="style-guide_code">#ff5b54 · background-color-red-light</p><p class="style-guide_usage">Red on black: big numbers, slider, active flag</p></div></div>
          <div class="style-guide_color"><div class="background-color-red-dark"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Red dark</p><p class="style-guide_code">#b42320 · background-color-red-dark</p><p class="style-guide_usage">Red text on light: strikes, risk values</p></div></div>
          <div class="style-guide_color"><div class="background-color-blush"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Blush</p><p class="style-guide_code">#fde3df · background-color-blush</p><p class="style-guide_usage">Active clause, icon circles, red pills</p></div></div>
          <div class="style-guide_color"><div class="background-color-blush-light"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Blush light</p><p class="style-guide_code">#fff4f2 · background-color-blush-light</p><p class="style-guide_usage">Gradient stop in the hero and CTA</p></div></div>
          <div class="style-guide_color"><div class="background-color-green"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Green</p><p class="style-guide_code">#1c7a43 · background-color-green</p><p class="style-guide_usage">Savings and suggested redlines</p></div></div>
          <div class="style-guide_color"><div class="background-color-green-light"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Green light</p><p class="style-guide_code">#e3f4e8 · background-color-green-light</p><p class="style-guide_usage">Savings badge, inserted text</p></div></div>
          <div class="style-guide_color"><div class="background-color-amber"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Amber</p><p class="style-guide_code">#f2b441 · background-color-amber</p><p class="style-guide_usage">Medium risk dot</p></div></div>
          <div class="style-guide_color"><div class="background-color-amber-light"><div class="style-guide_swatch"></div></div><div class="style-guide_color-info"><p class="style-guide_label">Amber light</p><p class="style-guide_code">#fdf0d5 · background-color-amber-light</p><p class="style-guide_usage">Medium risk pill</p></div></div>
        </div>
        <div class="style-guide_subheading" data-anim=""><p class="heading-style-h4">Logo</p><p class="text-size-small text-color-secondary">Redline's own logo, with the tagline typo fixed ("Reiew" to "Review") using the letters of the original file. The light version swaps the navy for white on dark backgrounds.</p></div>
        <div class="style-guide_tiles is-logo" data-anim-group="">
          <div class="style-guide_tile is-logo-white"><img class="brand_logo" src={asset('logo.webp')} alt="Redline MD logo" width="560" height="136"><p class="style-guide_code">logo.webp · brand_logo · 2.5 / 2.125rem tall</p></div>
          <div class="style-guide_tile is-logo-black"><img class="brand_logo" src={asset('logo-light.webp')} alt="Redline MD logo, light version" width="560" height="136"><p class="style-guide_code is-light">logo-light.webp · footer</p></div>
        </div>
        <div class="style-guide_subheading" data-anim=""><p class="heading-style-h4">Gradients</p></div>
        <div class="style-guide_colors is-2-columns" data-anim-group="">
          <div class="style-guide_color"><div class="style-guide_swatch is-tall is-gradient-hero"></div><div class="style-guide_color-info"><p class="style-guide_label">Hero</p><p class="style-guide_code">section-card is-hero · #ffffff → #fff4f2 → #fde3df</p></div></div>
          <div class="style-guide_color"><div class="style-guide_swatch is-tall is-gradient-cta"></div><div class="style-guide_color-info"><p class="style-guide_label">CTA</p><p class="style-guide_code">section-card is-cta · #fff4f2 → #fde3df</p></div></div>
        </div>
      </div></div>
    </section>
