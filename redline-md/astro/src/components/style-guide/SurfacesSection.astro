---
// Style guide section: Surfaces and cards
// Markup ported word for word from the original case-study.html.
import { asset } from '../../lib/site';
---
<section class="section_style-guide-surfaces" data-pane="style-guide" id="sg-surfaces">
      <div class="section-frame"><div class="section-card">
        <div class="padding-global padding-section-medium"><div class="container-large">
          <div class="heading_component is-narrow" data-anim=""><span class="text-style-eyebrow text-color-brand">06</span><h2 class="heading-style-h3">Surfaces and cards</h2><p class="text-color-secondary">Sections sit inside a rounded frame (section-frame &gt; section-card, radius 40). Cards inside use radius 32, smaller parts 24, 20 and 16.</p></div>
          <div class="style-guide_tiles" data-anim-group="">
            <div class="style-guide_tile is-gray"><p class="style-guide_code">section-card</p></div>
            <div class="style-guide_tile is-gradient-hero"><p class="style-guide_code">section-card is-hero</p></div>
            <div class="style-guide_tile is-gradient-cta"><p class="style-guide_code">section-card is-cta</p></div>
            <div class="style-guide_tile is-black"><p class="style-guide_code is-light">problem_card · demo_review · footer_component</p></div>
            <div class="style-guide_tile is-texture"><p class="style-guide_code">section-card is-texture</p></div>
            <div class="style-guide_tile is-white"><p class="style-guide_code">how_card · pricing_component · card_component</p></div>
          </div>
          <div class="style-guide_subheading" data-anim=""><p class="heading-style-h4">Cards in use</p></div>
          <div class="style-guide_cards" data-anim-group="">
            <div class="terms_card"><div class="terms_icon-wrapper"><svg class="terms_icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"></path></svg></div><div class="terms_card-content"><h3 class="heading-style-h4">Tail coverage</h3><p class="text-color-secondary">Who pays malpractice tail when you leave.</p></div></div>
            <div class="testimonials_card"><div class="testimonials_person"><img class="testimonials_avatar" src={asset('avatar-1.webp')} alt="" width="96" height="96"><div><div class="person_name">Dr. Emily Hart</div><div class="person_role">Family Medicine · 2025</div></div></div><p class="testimonials_quote">"The practice agreed to split it."</p><div class="testimonials_result"><span class="testimonials_result-value">50/50</span><span class="testimonials_result-label">tail coverage</span></div></div>
            <div class="how_card"><div class="how_number">01</div><div class="how_card-content"><h3 class="heading-style-h4">Upload</h3><p class="text-color-secondary">Add your contract, up to 30 pages.</p></div></div>
          </div>
          <div class="style-guide_radii" data-anim-group="">
            <div class="style-guide_radius is-40"><p class="style-guide_code">2.5rem · section-card</p></div>
            <div class="style-guide_radius is-32"><p class="style-guide_code">2rem · cards</p></div>
            <div class="style-guide_radius is-24"><p class="style-guide_code">1.5rem · shots, art</p></div>
            <div class="style-guide_radius is-16"><p class="style-guide_code">1rem · flags, clauses</p></div>
            <div class="style-guide_radius is-pill"><p class="style-guide_code">pill · buttons, pills</p></div>
          </div>
        </div></div>
      </div></div>
    </section>
