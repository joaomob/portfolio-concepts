            <div class="style-guide_link-row"><p class="style-guide_label">Paragraph</p><p class="style-guide_code">margin 0 · size and color from the body</p></div>
            <div class="style-guide_link-row"><p class="style-guide_label">H1</p><p class="style-guide_code">3.75 / 3 / 2.5 / 2.25rem · 600 · 1.15 · margin 0</p></div>
            <div class="style-guide_link-row"><p class="style-guide_label">H2</p><p class="style-guide_code">3 / 2.5 / 2.125rem · 600 · 1.15 · balance · margin 0</p></div>
            <div class="style-guide_link-row"><p class="style-guide_label">H3</p><p class="style-guide_code">2.5 / 2 / 1.75rem · 600 · 1.15 · balance · margin 0</p></div>
            <div class="style-guide_link-row"><p class="style-guide_label">H4</p><p class="style-guide_code">1.5rem · 600 · 1.2 · margin 0</p></div>
            <div class="style-guide_link-row"><p class="style-guide_label">H5</p><p class="style-guide_code">1.25rem · 600 · 1.3 · margin 0</p></div>
            <div class="style-guide_link-row"><p class="style-guide_label">H6</p><p class="style-guide_code">1.125rem · 600 · 1.4 · margin 0</p></div>
          </div>
