---
// Style guide section: Spacing and utilities
// Markup ported word for word from the original case-study.html.
---
<section class="section_style-guide-spacing" data-pane="style-guide" id="sg-spacing">
      <div class="section-frame"><div class="section-card">
        <div class="padding-global padding-section-medium"><div class="container-large">
          <div class="heading_component is-narrow" data-anim=""><span class="text-style-eyebrow text-color-brand">08</span><h2 class="heading-style-h3">Spacing and utilities</h2><p class="text-color-secondary">Spacers add vertical space between blocks without margins, and the hide classes remove an element per breakpoint.</p></div>
          <div class="style-guide_spacers" data-anim-group="">
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-tiny"></div></div><p class="style-guide_code">spacer-tiny · 0.125rem</p></div>
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-xxsmall"></div></div><p class="style-guide_code">spacer-xxsmall · 0.25rem</p></div>
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-xsmall"></div></div><p class="style-guide_code">spacer-xsmall · 0.5rem</p></div>
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-small"></div></div><p class="style-guide_code">spacer-small · 1rem</p></div>
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-medium"></div></div><p class="style-guide_code">spacer-medium · 2rem</p></div>
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-large"></div></div><p class="style-guide_code">spacer-large · 3rem</p></div>
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-xlarge"></div></div><p class="style-guide_code">spacer-xlarge · 4rem</p></div>
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-xxlarge"></div></div><p class="style-guide_code">spacer-xxlarge · 5rem</p></div>
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-huge"></div></div><p class="style-guide_code">spacer-huge · 6rem</p></div>
            <div class="style-guide_spacer"><div class="style-guide_bar"><div class="spacer-xhuge"></div></div><p class="style-guide_code">spacer-xhuge · 8rem</p></div>
          </div>
          <div class="style-guide_utils is-3-columns" data-anim-group="">
            <div class="style-guide_util"><p class="style-guide_label">Hide</p><p class="style-guide_code">hide · always</p><p class="style-guide_code">hide-tablet · 991 and below</p><p class="style-guide_code">hide-mobile-landscape · 767 and below</p><p class="style-guide_code">hide-mobile-portrait · 479 and below</p><div class="hide"></div><div class="hide-tablet"></div><div class="hide-mobile-landscape"></div><div class="hide-mobile-portrait"></div></div>
            <div class="style-guide_util overflow-hidden"><p class="style-guide_label">Overflow</p><p class="style-guide_code">overflow-hidden</p><p class="style-guide_code">overflow-visible</p><p class="style-guide_code">page-wrapper uses overflow clip, so sticky still works</p></div>
            <div class="style-guide_util overflow-visible"><p class="style-guide_label">Shadows</p><p class="style-guide_code">cards · 0 0 0 1px #eeeeee</p><p class="style-guide_code">floating · 0 40px 80px -30px red 35%</p><p class="style-guide_code">shots · 0 30px 60px -30px black 28%</p></div>
          </div>
        </div></div>
      </div></div>
    </section>
