---
// Style guide section: Layout
// Markup ported word for word from the original case-study.html.
---
<section class="section_style-guide-layout" data-pane="style-guide" id="sg-layout">
      <div class="padding-global padding-section-medium"><div class="container-large">
        <div class="heading_component is-narrow" data-anim=""><span class="text-style-eyebrow text-color-brand">07</span><h2 class="heading-style-h3">Layout</h2><p class="text-color-secondary">Client-First structure on every section. Horizontal padding lives only in padding-global, and containers only set the max width.</p></div>
        <div class="style-guide_structure" data-anim="">
          <div class="style-guide_box"><p class="style-guide_code">page-wrapper · overflow clip</p>
            <div class="style-guide_box is-main-wrapper"><p class="style-guide_code">main-wrapper</p>
              <div class="style-guide_box is-section"><p class="style-guide_code">section_[name] › section-frame (1.25 / 0.5rem) › section-card (radius 2.5rem)</p>
                <div class="style-guide_box is-padding-global"><p class="style-guide_code">padding-global padding-section-large · one div: 1.5rem sides, 8 / 6 / 4.5rem top and bottom</p>
                  <div class="style-guide_box is-container"><p class="style-guide_code">container-large · 79.5rem · container-small · 51.25rem</p>
                    <div class="style-guide_box is-content"><p class="style-guide_code">content · padding-section-medium 6 / 3.5rem · padding-section-small 3.5 / 3 / 2.5rem</p></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="style-guide_utils is-3-columns" data-anim-group="">
          <div class="style-guide_util"><p class="style-guide_label">Max width</p><p class="style-guide_code">max-width-small · 34rem</p><p class="style-guide_code">max-width-medium · 44rem</p><div class="max-width-large"><p class="style-guide_code">max-width-large · 54rem</p></div><div class="max-width-full"><p class="style-guide_code">max-width-full · none</p></div></div>
          <div class="style-guide_util"><p class="style-guide_label">Heading blocks</p><p class="style-guide_code">heading_component · gap 1.25rem, margin-bottom 3.5rem</p><p class="style-guide_code">heading_component is-center · left on tablet and mobile</p><p class="style-guide_code">heading_component is-flush · no margin</p></div>
          <div class="style-guide_util"><p class="style-guide_label">Grids</p><p class="style-guide_code">report_component · terms_component · how_component · testimonials_component</p><p class="style-guide_code">problem_component · demo_component · founder_component</p><p class="style-guide_code">1 column on tablet, carousel for testimonials</p></div>
        </div>
      </div></div>
    </section>
