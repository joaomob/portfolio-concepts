---
// Style guide section: Buttons
// Markup ported word for word from the original case-study.html.
---
<section class="section_style-guide-buttons" data-pane="style-guide" id="sg-buttons">
      <div class="section-frame"><div class="section-card">
        <div class="padding-global padding-section-medium"><div class="container-large">
          <div class="heading_component is-narrow" data-anim=""><span class="text-style-eyebrow text-color-brand">04</span><h2 class="heading-style-h3">Buttons</h2><p class="text-color-secondary">Black pills from the Longevity system. On hover a red layer (button-hover) slides up from the bottom and the button scales to 0.98.</p></div>
          <div class="style-guide_panel" data-anim-group="">
            <div class="style-guide_item"><a class="button" href="#"><span class="button_content">Upload your contract <span class="button_price">$199</span></span><span class="button_hover"></span></a><p class="style-guide_code">button · button_price</p></div>
            <div class="style-guide_item"><a class="button is-secondary" href="#"><span class="button_content">See a sample report</span></a><p class="style-guide_code">button is-secondary</p></div>
            <div class="style-guide_item"><a class="button is-accent" href="#"><span class="button_content">Check my contract · $199</span></a><p class="style-guide_code">button is-accent</p></div>
            <div class="style-guide_item"><a class="button is-small" href="#"><span class="button_content">Upload contract</span><span class="button_hover"></span></a><p class="style-guide_code">button is-small</p></div>
          </div>
          <div class="style-guide_panel is-dark" data-anim="">
            <div class="style-guide_item is-full"><a class="button is-accent is-full" href="#"><span class="button_content">Upload contract <span class="button_price">$199</span></span></a><p class="style-guide_code is-light">button is-accent is-full · sticky CTA on mobile</p></div>
          </div>
          <div class="style-guide_panel" data-anim-group="">
            <div class="style-guide_item"><div class="carousel_arrows"><div class="carousel_arrow is-off" role="button" tabindex="0" aria-label="Previous">←</div><div class="carousel_arrow" role="button" tabindex="0" aria-label="Next">→</div></div><p class="style-guide_code">carousel_arrow · is-off</p></div>
            <div class="style-guide_item"><div class="modal_close is-static" role="button" tabindex="0" aria-label="Close">×</div><p class="style-guide_code">modal_close</p></div>
            <div class="style-guide_item"><span class="tooltip_component is-light" tabindex="0" role="button" aria-label="What does this mean?">i</span><p class="style-guide_code">tooltip_component is-light</p></div>
            <div class="style-guide_item"><a class="navbar_link" href="#">How it works</a><p class="style-guide_code">navbar_link</p></div>
            <div class="style-guide_item"><div class="style-guide_on-dark"><a class="footer_link" href="#">Privacy Policy</a></div><p class="style-guide_code">footer_link</p></div>
          </div>
        </div></div>
      </div></div>
    </section>
