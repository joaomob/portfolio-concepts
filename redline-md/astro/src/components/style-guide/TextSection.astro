---
// Style guide section: Text utilities
// Markup ported word for word from the original case-study.html.
---
<section class="section_style-guide-text" data-pane="style-guide" id="sg-text">
      <div class="padding-global padding-section-medium"><div class="container-large">
        <div class="heading_component is-narrow" data-anim=""><span class="text-style-eyebrow text-color-brand">03</span><h2 class="heading-style-h3">Text utilities</h2><p class="text-color-secondary">Client-First utility classes to adjust one property without a new class.</p></div>
        <div class="style-guide_utils" data-anim-group="">
          <div class="style-guide_util"><p class="style-guide_label">Weight</p><p class="text-weight-normal">text-weight-normal · 400</p><p class="text-weight-medium">text-weight-medium · 500</p><p class="text-weight-semibold">text-weight-semibold · 600</p><p class="text-weight-bold">text-weight-bold · 700</p></div>
          <div class="style-guide_util"><p class="style-guide_label">Color</p><p class="text-color-black">text-color-black</p><p class="text-color-secondary">text-color-secondary</p><p class="text-color-brand">text-color-brand</p><p class="text-color-red">text-color-red</p><p class="text-color-green">text-color-green</p></div>
          <div class="style-guide_util"><p class="style-guide_label">Align</p><p class="text-align-left">text-align-left</p><p class="text-align-center">text-align-center</p><p class="text-align-right">text-align-right</p></div>
          <div class="style-guide_util"><p class="style-guide_label">Style</p><p class="text-style-allcaps">text-style-allcaps</p><p class="text-style-eyebrow text-color-brand">text-style-eyebrow</p><p class="text-style-balance">text-style-balance keeps titles free of orphans</p><p><span class="text-style-nowrap">text-style-nowrap keeps words together</span></p><div class="style-guide_on-dark"><p class="text-color-white">text-color-white on black</p></div></div>
        </div>
      </div></div>
    </section>
