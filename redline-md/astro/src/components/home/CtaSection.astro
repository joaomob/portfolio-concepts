---
// The final call, watched by the sticky CTA script ([data-final]).
// Markup ported word for word from the original index.html.
---
<section class="section_cta" data-final="">
      <div class="section-frame"><div class="section-card is-cta">
        <div class="cta_art" aria-hidden="true"><div class="art_doc is-cta-left"><div class="art_doc-head"><span class="art_logo"></span><span class="art_line is-width-40"></span></div><span class="art_line is-title"></span><span class="art_line is-width-90"></span><span class="art_line is-width-80"></span><span class="art_mark is-red"><span class="art_line is-width-70"></span></span><span class="art_line is-width-90"></span><span class="art_mark is-green"><span class="art_line is-width-60"></span></span><span class="art_line is-width-80"></span><span class="art_line is-width-50"></span></div><div class="art_tile is-cta-right"><span class="art_line is-width-50"></span><span class="art_big"></span><span class="art_meter"><span class="art_meter-fill"></span></span><span class="art_line is-width-70"></span></div></div>
        <div class="padding-global padding-section-medium"><div class="container-large"><div class="cta_component" data-anim="">
          <div class="max-width-medium"><h2 class="heading-style-h2">Review your contract before you sign it.</h2></div>
          <p class="text-size-large text-color-secondary">Flat $199. Report within 24 hours.</p>
          <a class="button" href="#" fs-modal-element="open" fs-modal-instance="upload"><span class="button_content">Upload your contract <span class="button_price">$199</span></span><span class="button_hover"></span></a>
        </div></div></div>
      </div></div>
    </section>
