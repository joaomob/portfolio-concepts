---
// Pricing: the three bars (Redline MD, a contract firm, an unnegotiated tail) and the source line.
// Markup ported word for word from the original index.html.
---
<section class="section_pricing" id="pricing">
      <div class="section-frame"><div class="section-card">
        <div class="padding-global padding-section-large"><div class="container-large">
          <div class="heading_component is-center" data-anim=""><h2 class="heading-style-h2">What a contract review costs</h2></div>
          <div class="pricing_component" data-anim="">
            <div class="pricing_row is-us"><div class="pricing_name">Redline MD <span class="pill is-green">Save up to $1,751</span></div><div class="pricing_track"><span class="pricing_bar is-us"></span></div><div class="pricing_value">$199</div></div>
            <div class="pricing_row"><div class="pricing_name">Physician contract firm</div><div class="pricing_track"><span class="pricing_bar is-firm"></span></div><div class="pricing_value">$480 to $1,950</div></div>
            <div class="pricing_row is-risk"><div class="pricing_name">Tail you didn't <span class="tooltip_trigger-wrapper">negotiate<span class="tooltip_component is-light" tabindex="0" role="button" aria-label="What does this mean?">i<span class="tooltip_bubble" role="tooltip">Also called extended reporting coverage. A one-time purchase that keeps you insured for claims filed after you leave, about care you gave while employed. It can cost up to 2× your annual premium, paid once (source: AMA Insurance).</span></span></span></div><div class="pricing_track"><span class="pricing_bar is-risk"></span></div><div class="pricing_value is-risk">$10,000+</div></div>
          </div>
          <div class="pricing_cta" data-anim="">
            <a class="button" href="#" fs-modal-element="open" fs-modal-instance="upload"><span class="button_content">Upload your contract <span class="button_price">$199</span></span><span class="button_hover"></span></a>
            <p class="pricing_source">Firm pricing: Contract Diagnostics published packages, September 2026.</p>
          </div>
        </div></div>
      </div></div>
    </section>
