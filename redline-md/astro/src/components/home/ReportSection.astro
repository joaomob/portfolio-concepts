---
// What the report includes: three cards, each with its own mock (summary, concerns, financial impact).
// Markup ported word for word from the original index.html.
---
<section class="section_report">
      <div class="padding-global padding-section-large"><div class="container-large">
        <div class="report_heading" data-anim="">
          <div class="max-width-medium"><h2 class="heading-style-h2">Everything in your report</h2></div>
          <a class="button" href="#sample-report" fs-modal-element="open" fs-modal-instance="report"><span class="button_content">See the full sample</span><span class="button_hover"></span></a>
        </div>
        <div class="report_component" data-anim-group="">
          <div class="report_card"><div class="report_card-content"><h3 class="heading-style-h4">Contract summary</h3><p class="text-color-secondary">Every section in plain English, on one page.</p></div><div class="report_visual"><div class="report_mock"><div class="report_mock-head"><span class="art_logo"></span><span class="report_mock-title">Contract summary</span></div><div class="report_mock-row"><span class="report_mock-label">Offer</span><span class="art_line is-width-80"></span></div><div class="report_mock-row"><span class="report_mock-label">Term</span><span class="art_line is-width-60"></span></div><div class="report_mock-row"><span class="report_mock-label">Duties</span><span class="art_line is-width-90"></span></div><div class="report_mock-row"><span class="report_mock-label">Bonus</span><span class="art_line is-width-50"></span></div></div></div></div>
          <div class="report_card"><div class="report_card-content"><h3 class="heading-style-h4">Areas of concern</h3><p class="text-color-secondary">The risk of each term and what negotiating it saves.</p></div><div class="report_visual"><div class="report_mock"><div class="report_mock-head"><span class="art_logo"></span><span class="report_mock-title">Areas of concern</span></div><div class="report_mock-risk"><span class="pill is-red">High</span><span class="report_mock-text">Sign-on repayment</span></div><div class="report_mock-risk"><span class="pill is-red">High</span><span class="report_mock-text">Non-compete radius</span></div><div class="report_mock-risk"><span class="pill is-amber">Medium</span><span class="report_mock-text">Vague bonus terms</span></div></div></div></div>
          <div class="report_card"><div class="report_card-content"><h3 class="heading-style-h4">Financial impact</h3><p class="text-color-secondary">Conservative and aggressive savings, in dollars.</p></div><div class="report_visual"><div class="report_mock"><div class="report_mock-head"><span class="art_logo"></span><span class="report_mock-title">Financial impact</span></div><div class="report_mock-bar-row"><span class="report_mock-text">Conservative</span><span class="report_mock-bar"><span class="report_mock-bar-fill is-40"></span></span><span class="report_mock-value">$20k–40k</span></div><div class="report_mock-bar-row"><span class="report_mock-text">Aggressive</span><span class="report_mock-bar"><span class="report_mock-bar-fill is-90"></span></span><span class="report_mock-value">$50k–100k</span></div></div></div></div>
        </div>
      </div></div>
    </section>
