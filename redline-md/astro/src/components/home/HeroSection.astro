---
// The hero: the tag, the H1, the two calls, the price note, the security line and the layered contract art.
// Markup ported word for word from the original index.html.
import { asset } from '../../lib/site';
---
<section class="section_hero">
      <div class="section-frame is-top">
        <div class="section-card is-hero">
          <div class="padding-global"><div class="container-large"><div class="hero_content">
            <div class="tag"><span class="tag_dot"></span>For physicians signing their first contract</div>
            <h1 class="heading-style-h1">Know what your contract costs before you sign.</h1>
            <div class="max-width-small"><p class="text-size-large text-color-secondary">AI contract review with redlines and a financial analysis. Flat $199, report within 24 hours.</p></div>
            <div class="button-group is-center">
              <a class="button is-hero" href="#" fs-modal-element="open" fs-modal-instance="upload" data-hero-cta=""><span class="button_content">Upload your contract <span class="button_price">$199</span></span><span class="button_hover"></span></a>
              <a class="button is-secondary is-hero" href="#sample-report" fs-modal-element="open" fs-modal-instance="report"><span class="button_content">See a sample report</span></a>
            </div>
            <div class="text-size-small text-color-secondary">Traditional legal review costs $500 or more.</div>
              <div class="hero_trust">ISO 27001 · AES256 · SOC2 · GDPR</div>
          </div></div></div>
          <div class="hero_art" aria-hidden="true"><div class="hero_art-layer"><div class="art_doc is-left"><div class="art_doc-head"><span class="art_logo"></span><span class="art_line is-width-40"></span></div><span class="art_line is-title"></span><span class="art_line is-width-90"></span><span class="art_line is-width-80"></span><span class="art_mark is-red"><span class="art_line is-width-70"></span></span><span class="art_line is-width-90"></span><span class="art_mark is-green"><span class="art_line is-width-60"></span></span><span class="art_line is-width-80"></span><span class="art_line is-width-50"></span></div></div><div class="hero_art-layer"><div class="art_tile is-right"><span class="art_line is-width-50"></span><span class="art_big"></span><span class="art_meter"><span class="art_meter-fill"></span></span><span class="art_line is-width-70"></span></div></div><div class="hero_art-layer"><div class="art_photo is-left"><img class="art_photo-image" src={asset('hero-1.webp')} alt="" width="960" height="720" loading="eager"></div></div><div class="hero_art-layer"><div class="art_photo is-right"><img class="art_photo-image" src={asset('hero-2.webp')} alt="" width="960" height="720" loading="eager"></div></div></div>
        </div>
      </div>
    </section>
