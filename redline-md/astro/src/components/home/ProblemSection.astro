---
// The problem: the costly clauses, the $10,000+ card and the three counters (fs-numbercount).
// Markup ported word for word from the original index.html.
---
<section class="section_problem">
      <div class="padding-global padding-section-large"><div class="container-large">
        <div class="problem_component">
          <div class="heading_component is-flush" data-anim="">
            <h2 class="heading-style-h2">The costly clauses show up when you leave.</h2>
            <p class="text-size-large text-color-secondary">Most first contracts are signed without a line-by-line review. Tail insurance and unnegotiated terms become the bill for your next job change.</p>
            <div class="button-group"><a class="button" href="#" fs-modal-element="open" fs-modal-instance="upload"><span class="button_content">Check my contract <span class="button_price">$199</span></span><span class="button_hover"></span></a></div>
          </div>
          <div>
            <div class="problem_card" data-anim="">
              <div class="problem_number">$<span fs-numbercount-element="number" fs-numbercount-end="10000" fs-numbercount-locale="en-US" fs-numbercount-duration="1600">10,000</span>+</div>
              <p class="problem_caption">What tail insurance and unnegotiated liabilities can cost a new physician.</p>
            </div>
            <div class="problem_stats" data-anim-group="">
              <div class="problem_stat"><div class="problem_stat-number"><span fs-numbercount-element="number" fs-numbercount-end="30">30</span>%</div><div class="problem_stat-label">Higher salary negotiated</div></div>
              <div class="problem_stat"><div class="problem_stat-number">$<span fs-numbercount-element="number" fs-numbercount-end="10000" fs-numbercount-locale="en-US">10,000</span></div><div class="problem_stat-label">Less liability exposure</div></div>
              <div class="problem_stat"><div class="problem_stat-number"><span fs-numbercount-element="number" fs-numbercount-end="3000">3,000</span>+</div><div class="problem_stat-label">Contracts reviewed</div></div>
            </div>
          </div>
        </div>
      </div></div>
    </section>
