---
// The physician behind Redline MD: the portrait, the quote and the credentials (illustrative person).
// Markup ported word for word from the original index.html.
import { asset } from '../../lib/site';
---
<section class="section_founder">
      <div class="section-frame"><div class="section-card">
        <div class="founder_padding"><div class="container-large">
          <div class="founder_component" data-anim="">
            <img class="founder_image" src={asset('founder.webp')} alt="Dr. Alan Brooks, founder of Redline MD" width="430" height="518" loading="lazy">
            <div class="founder_content">
              <div class="tag"><span class="tag_dot"></span>The physician behind Redline MD</div>
              <p class="founder_quote">"I signed my first contract without understanding the tail clause. It cost me $22,000 when I changed jobs. Redline MD exists so that doesn't happen to you."</p>
              <div class="founder_meta"><div class="person_name">Dr. Alan Brooks, MD</div><div class="person_role">Founder and Medical Director · Internal Medicine</div></div>
              <div class="founder_credentials"><span class="pill is-gray">Board-certified physician</span><span class="pill is-gray">Clause library reviewed by healthcare attorneys</span></div>
            </div>
          </div>
        </div></div>
      </div></div>
    </section>
