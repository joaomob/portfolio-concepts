---
// The testimonials: a grid on desktop and a carousel with dots and arrows below 992 px (home.js), from
// data/testimonials.ts.
import { testimonials } from '../../data/testimonials';
import { asset } from '../../lib/site';
---
<section class="section_testimonials">
      <div class="padding-global padding-section-large"><div class="container-large">
        <div class="heading_component is-center" data-anim=""><h2 class="heading-style-h2">{testimonials.heading}</h2></div>
        <div class="testimonials_component" data-anim-group="" data-carousel="">
          {testimonials.items.map((item) => (
          <div class="testimonials_card">
            <div class="testimonials_person"><img class="testimonials_avatar" src={asset(item.avatar)} alt="" width="96" height="96"><div><div class="person_name">{item.name}</div><div class="person_role">{item.role}</div></div></div>
            <p class="testimonials_quote">{item.quote}</p>
            <div class="testimonials_result"><span class="testimonials_result-value">{item.value}</span><span class="testimonials_result-label">{item.label}</span></div>
          </div>
          ))}
        </div>
        <div class="carousel_nav" data-carousel-nav=""><div class="carousel_dots">{testimonials.items.map((_, i) => <span class={i === 0 ? 'carousel_dot is-active' : 'carousel_dot'} data-dot={String(i)}></span>)}</div><div class="carousel_arrows"><div class="carousel_arrow is-off" role="button" tabindex="0" aria-label="Previous testimonial" data-dir="-1">←</div><div class="carousel_arrow" role="button" tabindex="0" aria-label="Next testimonial" data-dir="1">→</div></div></div>
      </div></div>
    </section>
