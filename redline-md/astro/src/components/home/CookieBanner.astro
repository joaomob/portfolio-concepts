---
// The cookie banner (fs-cc banner): reject, accept and the link to the preferences.
// Markup ported word for word from the original index.html.
---
<div class="cookie_banner" fs-cc="banner" role="region" aria-label="Cookie consent">
      <p class="cookie_title">Cookies</p>
      <p class="text-size-small text-color-secondary">We use cookies to measure traffic and improve your experience.</p>
      <div class="cookie_actions"><a class="button is-small is-secondary" href="#" fs-cc="deny"><span class="button_content">Reject</span></a><a class="button is-small" href="#" fs-cc="allow"><span class="button_content">Accept</span></a></div>
      <a class="cookie_link" href="#cookie-settings" fs-cc="open-preferences">Choose cookies</a>
    </div>
