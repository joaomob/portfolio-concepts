---
// The upload modal (fs-modal, slide-up): file, email and payment, in three steps.
// Markup ported word for word from the original index.html.
---
<div class="modal_component" fs-modal-element="modal" fs-modal-instance="upload" fs-modal-animation="slide-up" role="dialog" aria-modal="true" aria-label="Upload your contract">
      <div class="modal_card">
        <div class="modal_close" fs-modal-element="close" fs-modal-instance="upload" role="button" tabindex="0" aria-label="Close">×</div>
        <div class="modal_progress" aria-hidden="true"><span class="modal_progress-bar is-active" data-bar="1"></span><span class="modal_progress-bar" data-bar="2"></span><span class="modal_progress-bar" data-bar="3"></span></div>
        <div class="modal_upload-step is-active" data-step="1">
          <p class="modal_step">Step 1 of 3</p>
          <p class="modal_title">Upload your contract</p>
          <label class="modal_dropzone" data-drop=""><input type="file" accept=".pdf,.doc,.docx" hidden="" data-file=""><span class="modal_dropzone-title" data-drop-text="">Drop your file or tap to choose</span><span class="text-size-small text-color-secondary">PDF or Word, up to 30 pages</span></label>
          <div class="spacer-small"></div><a class="button is-full" href="#" data-next="2"><span class="button_content">Continue</span></a>
          <p class="modal_foot">Report within 24 hours · No account needed</p>
        </div>
        <div class="modal_upload-step" data-step="2">
          <p class="modal_step">Step 2 of 3</p>
          <p class="modal_title">Where should we send your report?</p>
          <input class="modal_field" type="email" placeholder="you@hospital.org" aria-label="Email" data-email="">
          <a class="button is-full" href="#" data-next="3"><span class="button_content">Continue to payment</span></a>
        </div>
        <div class="modal_upload-step" data-step="3">
          <p class="modal_step">Step 3 of 3</p>
          <p class="modal_title">Pay $199</p>
          <div class="modal_pay-row"><span>Contract review</span><span>$199</span></div>
          <a class="button is-accent is-full" href="#" data-pay=""><span class="button_content">Pay $199</span></a>
          <p class="modal_foot">Your report arrives within 24 hours.</p>
        </div>
      </div>
    </div>
