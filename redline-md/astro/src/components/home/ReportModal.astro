---
// The sample report modal (fs-modal, fade): the five pages behind a shield, protected from copy by home.js, from
// data/report.ts.
import { report } from '../../data/report';
import { asset } from '../../lib/site';
---
<div class="modal_component" fs-modal-element="modal" fs-modal-instance="report" fs-modal-animation="fade" role="dialog" aria-modal="true" aria-label="Sample report">
      <div class="modal_card is-report">
        <div class="modal_close" fs-modal-element="close" fs-modal-instance="report" role="button" tabindex="0" aria-label="Close">×</div>
        <div class="sample_head"><span class="heading-style-h4">{report.title}</span><a class="button is-small" href="#" fs-modal-element="open" fs-modal-instance="upload"><span class="button_content">{report.cta}</span></a></div>
        <div class="sample_pages">
          {report.pages.map((p) => <div class="sample_page-wrapper"><img class="sample_page" src={asset(p.src)} alt={p.alt} width="1200" height="1553" loading="lazy"><div class="sample_shield" aria-hidden="true"></div></div>)}
        </div>
      </div>
    </div>
