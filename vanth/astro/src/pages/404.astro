---
// The page shown for an address that does not exist: the way back to the house and the eight lines of the season.
import BaseLayout from '../layouts/BaseLayout.astro';
import { lines, collectionPage } from '../lib/catalog';
import { href } from '../config';
---
<BaseLayout title="Page not found | Vanth" description="Page not found at Vanth. Go back to the house or open one of the eight lines." page="404" current={null}>
  <section class="section_not-found">
    <div class="padding-global">
      <div class="container-large">
        <p class="not-found_number" aria-hidden="true">404</p>
        <div class="not-found_content">
          <p class="text-style-label">Autumn Winter 2026</p>
          <h1 class="heading-style-h2">Page not&nbsp;found</h1>
          <p class="not-found_text">The season has eight lines, and all of them are&nbsp;below.</p>
          <a href={href('')} class="button is-alternate">Back to the&nbsp;house</a>
        </div>
        <ul class="not-found_list" role="list">
          {lines.map((line) => (
            <li class="not-found_item"><a href={href(collectionPage(line))} class="not-found_link"><span class="text-style-label">{line.number}</span><span class="heading-style-h3">{line.name}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
