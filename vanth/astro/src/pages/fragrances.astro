---
// The eight fragrances of the season, one card each: the notes are the part of the line before ", in" (the bottle).
import ListPage from '../components/templates/ListPage.astro';
import { lines, fragrancePage } from '../lib/catalog';
import { href } from '../config';

const cards = lines.map((line) => ({
  href: href(fragrancePage(line)), image: line.scent.image, alt: line.scent.alt,
  number: line.number, name: line.fragrance,
  tag: line.scent.notes.split(', in ')[0].replace(/\.+$/, ''),
  meta: `Eau de parfum of ${line.name}, ${line.scent.price}`,
}));
---
<ListPage
  title="Fragrances, eight eaux de parfum | Vanth"
  description="The eight Vanth eaux de parfum, one for each line of the season: Slate, Amethyst, Asphalt, Halide, Gilt, Vermilion, Feedback and Sanguine."
  page="fragrances" current="fragrances"
  label="Eight eaux de parfum" heading="Fragrances" lead="One fragrance for each line, in a bottle cut to match it. Open one to read its notes."
  cards={cards}
/>
