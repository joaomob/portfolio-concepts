---
// One look of a line: the photograph with a dot over each piece (a dot opens the card of that piece, and the card is a
// link to its product page) beside the name and the story of the look. The looks alternate sides.
import Photo from '../shared/Photo.astro';
import type { Line, Look } from '../../lib/types';
import { productPageByName } from '../../lib/catalog';
import { tie } from '../../lib/text';
import { href } from '../../config';

interface Props {
  line: Line;
  look: Look;
  index: number;
}
const { line, look, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const dots = look.dots.map((dot) => ({
  ...dot,
  // the card opens at the outer edge of the photograph, on the side away from the dot, level with it
  side: dot.left <= 50 ? 'is-right' : 'is-left',
  cardTop: Math.min(Math.max(dot.top - 6, 4), 76),
  cardId: `piece-${line.slug}-${dot.id}`,
  page: href(productPageByName(line, dot.name)),
}));
---
<section id={`look-${number}`} class:list={['section_look', { 'is-reverse': index % 2 === 1 }]} data-look>
  <div class="padding-global">
    <div class="container-large">
      <div class="look-shop_layout">
        <div class="look-shop_photo" data-look-photo>
          <Photo name={look.image} loading="lazy" alt={look.alt} />
          {dots.map((dot) => (
            <>
              <a class="look-shop_dot" href={dot.page} data-left={String(dot.left)} data-top={String(dot.top)} data-dot data-card-id={dot.cardId} data-open="false"><span class="visually-hidden">{dot.name}, {dot.price}, see the piece</span></a>
              <a class={`look-shop_card ${dot.side}`} href={dot.page} id={dot.cardId} data-top={String(dot.cardTop)} tabindex="-1" aria-hidden="true" data-card data-card-state="closed">
                <span class="text-style-label">Look {number}, {dot.label}</span>
                <span class="look-shop_card-name">{dot.name}</span>
                <span class="text-style-label">{dot.material}</span>
                <span class="look-shop_card-row"><span class="look-shop_price">{dot.price}</span><span class="look-shop_card-link text-style-label">See the piece</span></span>
              </a>
            </>
          ))}
        </div>
        <div class="look-shop_text">
          <p class="look-shop_number" aria-hidden="true">{number}</p>
          <h2 class="heading-style-h2">{tie(look.title)}</h2>
          <p class="look-shop_body">{tie(look.body)}</p>
          {index === 0 && <p class="text-style-label look-shop_hint">Select a dot to open the&nbsp;piece</p>}
        </div>
      </div>
    </div>
  </div>
</section>
