---
// What the head of every page carries: noindex (the concept pages stay out of search), the canonical address on
// joaomob.com, the favicon and the display font preloaded.
// Inter Tight and JetBrains Mono wait for the page to load (the first photograph and Anton go first): until then the
// text is drawn with the stand-ins of the same width declared in tokens.css, so nothing moves when they arrive. One
// family at a time (0.3 s and 0.9 s after the load event), so the page is laid out again in two short steps.
import { canonical } from '../../lib/links';
import { BASE } from '../../config';

interface Props {
  title: string;
  description: string;
  /** the page, without the base path ("" for the Home) */
  page: string;
}
const { title, description, page } = Astro.props;
const fonts = `${BASE}/assets/fonts`;
const range = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const late = [
  `@font-face{font-family:'Inter Tight';font-style:normal;font-weight:400 500;font-display:swap;src:url('${fonts}/inter-tight-latin.woff2') format('woff2');unicode-range:${range}}`,
  `@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400 500;font-display:swap;src:url('${fonts}/jetbrains-mono-latin.woff2') format('woff2');unicode-range:${range}}`,
];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical(BASE, page)} />
<link rel="icon" href={`${BASE}/assets/favicon.svg`} type="image/svg+xml" />
<link rel="preload" href={`${fonts}/anton-latin.woff2`} as="font" type="font/woff2" crossorigin />
{late.map((face, i) => <style is:inline data-late-fonts={String(i)} media="not all" set:html={face} />)}
<script is:inline>addEventListener('load', function () { document.querySelectorAll('[data-late-fonts]').forEach(function (sheet, i) { setTimeout(function () { sheet.media = 'all'; }, 300 + i * 600); }); });</script>
