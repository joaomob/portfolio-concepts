---
// The footer of every page: the links of the menu, the credit and the giant wordmark (it rises with the scroll on the
// pages that carry the animation library, so it is marked for the script there).
import { homeAnchor } from '../../lib/links';
import { BASE, href } from '../../config';

interface Props {
  onHome?: boolean;
  /** the wordmark rises as the footer arrives */
  motion?: boolean;
}
const { onHome = false, motion = false } = Astro.props;
---
<footer class="footer_component background-color-paper">
  <div class="padding-global">
    <div class="footer_top">
      <nav class="footer_links" aria-label="Footer">
        <a href={href('collections')} class="nav_link text-style-label">Collections</a>
        <a href={href('fragrances')} class="nav_link text-style-label">Fragrances</a>
        <a href={homeAnchor(BASE, onHome, 'lookbook')} class="nav_link text-style-label">Lookbook</a>
        <a href={homeAnchor(BASE, onHome, 'departments')} class="nav_link text-style-label">Shop</a>
      </nav>
      <p class="text-style-label">Concept site. Design and development by <a href="https://joaomob.com" class="footer_credit">joaomob.com</a></p>
    </div>
  </div>
  <p class="footer_wordmark" aria-hidden="true" data-footer-wordmark={motion ? '' : undefined}>Vanth</p>
</footer>
