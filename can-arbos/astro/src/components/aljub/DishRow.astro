---
// One dish of the menu: name, price, text, then its diets and the allergens it contains. The diets also go in a data
// attribute that the menu filter reads.
import type { Dish } from '@data/dining';

interface Props {
  dish: Dish;
}
const { dish } = Astro.props;
const diets = dish.diets.length ? `${dish.diets.join(' · ')} · ` : '';
const allergens = dish.allergens.length ? `Contains: ${dish.allergens.join(', ')}` : 'None of the 14 allergens';
---
<li class="dish_list_item" data-filter-item data-filter-diet={dish.diets.join('|')}><h4 class="dish_list_name u-text-style-h4">{dish.name}</h4><span class="dish_list_line" aria-hidden="true"></span><p class="dish_list_price u-text-style-h4">€{dish.price}</p><p class="dish_list_text">{dish.description}</p><p class="dish_list_meta">{diets}{allergens}</p></li>
