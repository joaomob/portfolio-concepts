---
// The rooftop plunge pool and the spa in the old cellar.
import { page, img } from '@lib/paths';
import { useTranslate, type Lang } from '@i18n/index';

interface Props {
  lang: Lang;
}
const t = useTranslate(Astro.props.lang);
---
<section class="roof_home_wrap u-section u-theme-light" aria-labelledby="roof-title">
  <div class="roof_home_contain u-container">
    <div class="roof_home_layout">
      <figure class="roof_home_media"><img {...img("rooftop/pool-sunset.webp", 1600)} class="roof_home_image" alt={t("A small plunge pool on the roof at sunset, with a wooden pergola, loungers and the cathedral on the skyline")} width="1600" height="893" loading="lazy" /></figure>
      <div class="roof_home_content">
        <p class="eyebrow_text">{t("Rooftop & Spa")}</p>
        <h2 class="roof_home_title u-text-style-h2" id="roof-title">{t("A rooftop plunge pool")}</h2>
        <p class="roof_home_text">{t("It's 6 by 3 metres and 1.4 metres deep. A pergola shades half the deck from noon. Open 9:00 to 20:00, with drinks from the bar until 23:00.")}</p>
      </div>
      <div class="roof_home_spa">
        <img {...img("rooftop/spa-steam-room.webp", 900)} class="roof_home_arch is-arch" alt={t("A small steam room with stone benches under a vaulted ceiling, lit from a niche")} width="900" height="1117" loading="lazy" />
        <div class="roof_home_block">
          <h3 class="roof_home_subtitle u-text-style-h3">{t("Spa in the old cellar")}</h3>
          <p class="roof_home_text">{t("Two treatment rooms and a steam room. Book a treatment at reception or from My stay.")}</p>
          <a class="link_arrow_wrap" href={page("rooftop-spa")}>{t("See rooftop and spa")}</a>
        </div>
      </div>
    </div>
  </div>
</section>
