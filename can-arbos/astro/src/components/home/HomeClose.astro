---
// The closing band: the cancellation line and the booking buttons.
import Button from '@components/ui/Button.astro';
import { useTranslate, type Lang } from '@i18n/index';

interface Props {
  lang: Lang;
}
const t = useTranslate(Astro.props.lang);
---
<section class="close_home_wrap u-section u-theme-dark" aria-label={t("Book")}>
  <div class="close_home_contain u-container">
    <div class="close_home_layout">
      <p class="close_home_line u-text-style-h2">{t("Free room cancellation up to 7 days before arrival.")}</p>
      <div class="u-button-wrapper">
        <Button label={t("Book a room")} modal="room-modal" />
        <Button label={t("Book a table")} variant="secondary" modal="table-modal" />
      </div>
    </div>
  </div>
</section>
