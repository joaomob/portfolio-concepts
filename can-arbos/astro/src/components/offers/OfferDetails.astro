---
// What an offer includes, what to know, the rooms it applies to and the booking button. On the members' offer the
// details stay hidden behind the sign-in panel until the visitor signs in.
import Button from '@components/ui/Button.astro';
import { page } from '@lib/paths';
import type { Offer } from '@data/offers';

interface Props {
  offer: Offer;
}
const { offer } = Astro.props;
const locked = offer.members ? { 'data-member-only': true, 'data-visible': 'false' } : {};
---
<section class="offer_page_wrap u-section u-theme-light" aria-label="About this offer">
  <div class="offer_page_contain u-container">
    {offer.members && (
      <div class="offer_lock_wrap" data-member-locked>
        <p class="offer_lock_text u-text-style-large">Sign in or create a free account to see what's included.</p>
        <div class="u-button-wrapper"><Button label="Create an account" href={page('members')} /><Button label="Sign in" variant="secondary" href={page('members')} /></div>
      </div>
    )}
    <div class="offer_page_layout" {...locked}>
      <div class="offer_page_block">
        <h2 class="offer_page_title u-text-style-h3">What's included</h2>
        <div class="offer_page_rich"><ul class="offer_page_list">{offer.included.map((item) => <li class="offer_page_item">{item}</li>)}</ul></div>
      </div>
      <div class="offer_page_block is-second">
        <h2 class="offer_page_title u-text-style-h3">Good to know</h2>
        <p class="offer_page_text">{offer.know}</p>
        {offer.rooms && <ul class="fact_line_list"><li>Rooms: {offer.rooms}</li></ul>}
        <div class="u-button-wrapper"><Button label="Book this offer" modal="room-modal" data-offer={offer.name} /></div>
      </div>
    </div>
  </div>
</section>
