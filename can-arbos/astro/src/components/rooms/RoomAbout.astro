---
// The room's text and a table of what the opening does not say yet (size, guests and view are in its line of facts).
import type { Room } from '@data/rooms';

interface Props {
  room: Room;
}
const { room } = Astro.props;
const facts: [string, string][] = [
  ['Bed', room.bed],
  ['Bathroom', room.bathroom],
  ['Light', room.light],
  ['Rooms like this', String(room.count)],
];
---
<section class="room_page_wrap u-section u-theme-light" aria-label={`About the ${room.name}`}>
  <div class="room_page_contain u-container">
    <div class="room_page_layout">
      <p class="room_page_text u-text-style-large">{room.text}</p>
      <dl class="fact_table_wrap">
        {facts.map(([name, value]) => (
          <div class="fact_table_row"><dt class="fact_table_name">{name}</dt><dd class="fact_table_value">{value}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>
