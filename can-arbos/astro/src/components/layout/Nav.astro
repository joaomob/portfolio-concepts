---
// The menu of every page: the bar, the three mega panels and the phone menu. On the Spanish Home the texts are in
// Spanish, the logo leads to /es and the language link turns to English.
import Button from '@components/ui/Button.astro';
import { page, img } from '@lib/paths';
import { useTranslate, type Lang } from '@i18n/index';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslate(lang);
const home = lang === 'es' ? page('es') : page();
const other =
  lang === 'es'
    ? { href: page(), lang: 'en', name: 'English', code: 'EN' }
    : { href: page('es'), lang: 'es', name: 'Español', code: 'ES' };
