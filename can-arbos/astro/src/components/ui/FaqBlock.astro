---
// A block of questions: the first one opens with the page, and opening another closes it (site.js animates the height).
import type { FaqItem } from '@data/types';
import { useTranslate, type Lang } from '@i18n/index';

interface Props {
  title: string;
  items: FaqItem[];
  lang?: Lang;
}
const { title, items, lang = 'en' } = Astro.props;
const t = useTranslate(lang);
---
<section class="faq_home_wrap u-section u-theme-light" aria-labelledby="faq-title">
  <div class="faq_home_contain u-container">
    <div class="faq_home_layout">
      <div class="faq_home_head">
        <p class="eyebrow_text">{t('Questions')}</p>
        <h2 class="faq_home_title u-text-style-h2" id="faq-title">{t(title)}</h2>
      </div>
      <div class="faq_list_wrap">
        {items.map((item, i) => (
          <details class="faq_item" open={i === 0}><summary class="faq_question"><h3 class="faq_question_text u-text-style-h4">{t(item.question)}</h3><span class="faq_icon" aria-hidden="true"></span></summary><p class="faq_answer">{t(item.answer)}</p></details>
        ))}
      </div>
    </div>
  </div>
</section>
