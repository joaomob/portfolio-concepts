---
// The opening of an inner page: night theme, the text on the left and the photo in an arch on the right.
// The eyebrow is a slot, since on a room page it is a link back to the rooms; the default slot goes under the text.
import { img } from '@lib/paths';

interface Props {
  title: string;
  text: string;
  /** the photo under assets/images/, with .webp */
  image: string;
  alt: string;
  eyebrow?: string;
  /** long titles (experiences) take one more column and the h2 size */
  long?: boolean;
  /** the guides of the journal have the longest titles */
  guide?: boolean;
}

const { title, text, image, alt, eyebrow, long = false, guide = false } = Astro.props;
const layout = ['page_hero_layout', long && 'is-long', guide && 'is-guide'].filter(Boolean).join(' ');
---
<section class="page_hero_wrap u-theme-dark" aria-labelledby="page-title">
  <div class="page_hero_contain u-container">
    <div class={layout}>
      <div class="page_hero_content">
        <p class="eyebrow_text"><slot name="eyebrow">{eyebrow}</slot></p>
        <h1 class={`page_hero_title u-text-style-${long ? 'h2' : 'h1'}`} id="page-title">{title}</h1>
        <p class="page_hero_text u-text-style-large">{text}</p>
        <slot />
      </div>
      <img class="page_hero_image is-arch" {...img(image, 900)} alt={alt} width="900" height="1117" fetchpriority="high" />
    </div>
  </div>
</section>
