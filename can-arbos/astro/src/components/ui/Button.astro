---
// The Lumos button of the site (button_main_wrap). It opens a modal, submits a form, or goes to a page; a link
// button is a cover link over the visual element, as the Lumos component is built in Webflow.
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'button'>, 'type'> {
  label: string;
  variant?: 'primary' | 'secondary' | 'link';
  /** the id of the <dialog> the button opens */
  modal?: string;
  /** a page address: the button becomes a link */
  href?: string;
  type?: 'button' | 'submit';
  /** extra combo classes on the wrapper (is-desktop, is-tablet) */
  wrapClass?: string;
}

const { label, variant = 'primary', modal, href, type = 'button', wrapClass, ...attrs } = Astro.props;
const VARIANT = {
  primary: '',
  secondary: ' w-variant-e85564cd-af30-a478-692b-71732aefb3ab',
  link: ' w-variant-625d5df4-ad91-f7dc-9e2f-2e69f3fd7400',
};
const v = VARIANT[variant];
const wrap = `button_main_wrap${v}${wrapClass ? ` ${wrapClass}` : ''}`;
---
{href ? (
  <div data-trigger="hover focus" class={wrap}><div class="clickable_wrap u-cover-absolute"><a href={href} class="clickable_link w-inline-block" aria-label={label}></a></div><div class={`button_main_element${v}`}><div aria-hidden="true" class="button_main_text u-text-style-main">{label}</div>{variant === 'link' && <div class={`button_main_line${v}`}></div>}</div></div>
) : (
  <div data-trigger="hover focus" class={wrap}><button type={type} class={`button_main_element${v}`} data-modal-open={modal} {...attrs}><span class="button_main_text u-text-style-main">{label}</span></button></div>
)}
