---
// The preferences card of "My stay": diets, allergies, coffee, pillow and what the member is celebrating.
import Button from '@components/ui/Button.astro';
import { DIETS } from '@data/dining';

const FIELDS: [name: string, label: string][] = [
  ['allergies', 'Allergies'],
  ['coffee', 'How do you take your coffee?'],
];
---
<section class="member_card_wrap is-wide" aria-labelledby="prefs-title">
  <h2 class="member_card_title u-text-style-h3" id="prefs-title">Your preferences</h2>
  <form class="member_form_wrap" data-member-form="prefs" novalidate>
    <fieldset class="member_form_group"><legend class="field_label">Diet, choose any</legend>{DIETS.map((diet) => <label class="check_wrap"><input type="checkbox" name="diet" value={diet} /> {diet}</label>)}</fieldset>
    <div class="modal_grid">
      {FIELDS.map(([name, label]) => (
        <div class="field_wrap"><label class="field_label" for={`pref-${name}`}>{label}</label><input class="field_input" id={`pref-${name}`} name={name} type="text" /></div>
      ))}
      <div class="field_wrap"><label class="field_label" for="pref-pillow">Pillow</label><select class="field_input" id="pref-pillow" name="pillow"><option value="Soft">Soft</option><option value="Firm">Firm</option></select></div>
      <div class="field_wrap"><label class="field_label" for="pref-celebrating">Are you celebrating anything?</label><input class="field_input" id="pref-celebrating" name="celebrating" type="text" /></div>
    </div>
    <Button label="Save preferences" type="submit" />
    <p class="modal_result" data-form-success data-visible="false">Saved. We'll have these ready for your next visit.</p>
  </form>
</section>
