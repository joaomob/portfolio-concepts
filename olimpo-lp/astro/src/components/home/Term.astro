---
// An inline glossary term: opens the short definition of a Codex entry (olimpo.js listens on data-term).
interface Props {
  entry: string;
  light?: boolean;
}

const { entry, light = false } = Astro.props;
---
<button class={light ? 'term is-light' : 'term'} type="button" data-term={entry}><slot /></button>
