    {
      "className": "section_components background-color-secondary",
      "id": "components",
      "blocks": [
        {
          "type": "header",
          "num": "06",
          "title": "Components"
        },
        {
          "type": "html",
          "html": "<p class=\"text-size-regular text-color-secondary max-width-60ch\">Each of these is a Webflow Component, not a class with a combo, so one edit reaches\n    every instance. Component classes use the underscore form. Motion is attached by\n    attribute, never by class.</p>"
        },
        {
          "type": "html",
          "html": "<div class=\"spacer-medium\"></div>"
        },
        {
          "type": "gap"
        },
        {
          "type": "row",
          "spec": "<b>Button</b>.button<br>.is-secondary<br>.is-text<br>.is-small · .is-large<br>.button-group",
          "body": "<div class=\"button-group\"><a href=\"#\" class=\"button is-large\">Start now</a><a href=\"#\" class=\"button\">Start now</a><a href=\"#\" class=\"button is-secondary\">See archetypes</a><a href=\"#\" class=\"button is-text\">Learn more</a><a href=\"#\" class=\"button is-small\">Small</a></div>"
        },
        {
          "type": "gap"
        },
        {
          "type": "row",
          "spec": "<b>Navigation</b>.nav_component<br>.nav_logo<br>.nav_menu<br>.nav_menu-link",
          "body": "<div class=\"nav_component background-color-tertiary padding-horizontal padding-small\" style=\"border-radius:var(--radius-small)\"><div class=\"nav_logo\">Olimpo</div><nav class=\"nav_menu\"><a href=\"#\" class=\"nav_menu-link\">Archetypes</a><a href=\"#\" class=\"nav_menu-link\">Pricing</a><a href=\"#\" class=\"nav_menu-link\">Glossary</a></nav></div>"
        },
        {
          "type": "gap"
        },
        {
          "type": "row",
          "spec": "<b>Big quote</b>.big-quote_component<br>.big-quote_eyebrow<br>.big-quote_text<br>.big-quote_rule<br>.big-quote_attribution",
          "body": "<div class=\"big-quote_component\"><div class=\"big-quote_eyebrow\">From the beta</div><div class=\"big-quote_text\">I stopped starting over every Monday.</div><div class=\"big-quote_rule\"></div><div class=\"big-quote_attribution\">Beta user · choleric</div></div>"
        },
        {
          "type": "gap"
        },
        {
          "type": "row",
          "spec": "<b>Footer</b>.footer_component<br>.footer_layout<br>.footer_col-title<br>.footer_col-list<br>.footer_link<br>.footer_legal",
          "body": "<div class=\"footer_component\"><div class=\"footer_layout\">\n      <div><div class=\"nav_logo\">Olimpo</div><p class=\"text-size-small text-color-tertiary max-width-xsmall margin-top margin-xsmall\">Goals that survive the week you have, not the week you planned.</p></div>\n      <div><div class=\"footer_col-title\">Product</div><div class=\"footer_col-list\"><a href=\"#\" class=\"footer_link\">Archetypes</a><a href=\"#\" class=\"footer_link\">Pricing</a><a href=\"#\" class=\"footer_link\">Changelog</a></div></div>\n      <div><div class=\"footer_col-title\">Learn</div><div class=\"footer_col-list\"><a href=\"#\" class=\"footer_link\">Glossary</a><a href=\"#\" class=\"footer_link\">Community</a></div></div>\n    </div><div class=\"footer_legal\"><span>© 2026 Olimpo</span><a href=\"#\" class=\"footer_link\">Privacy</a><a href=\"#\" class=\"footer_link\">Terms</a><a href=\"#\" class=\"footer_link\">Style guide</a></div></div>"
        },
        {
          "type": "gap"
        },
        {
          "type": "row",
          "spec": "<b>Motion attributes</b>data-reveal<br>data-reveal-delay<br>data-reveal-duration<br>data-reveal-y",
          "body": "<div class=\"text-size-small text-color-secondary max-width-60ch\">Behaviour lives on the attribute, styling on the class. Defaults are 0.8s and 24px,\n      each overridable per element from the Settings panel without touching code.</div>"
        },
        {
          "type": "gap"
        },
        {
          "type": "row",
          "spec": "<b>Motion tokens</b>--ease<br>--duration",
          "body": "<div class=\"text-size-small text-color-secondary max-width-60ch\">One easing, <code>cubic-bezier(.22, 1, .36, 1)</code>, and one duration, 500ms. Anything\n      driven by scroll scrub is linear instead, because an eased curve fights the scroll position.</div>"
        }
      ]
    }
