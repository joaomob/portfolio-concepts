        {
          "type": "row",
          "spec": "<b>.max-width-large</b>48em",
          "body": "<div class=\"sg-box max-width-large\" style=\"height:1.5em\"></div>"
        },
        {
          "type": "row",
          "spec": "<b>.max-width-50ch</b>measure",
          "body": "<div class=\"text-size-regular text-color-secondary max-width-50ch\">Fifty characters is where a line stops being comfortable to read.</div>"
        },
        {
          "type": "row",
          "spec": "<b>.max-width-60ch</b>long-form",
          "body": "<div class=\"text-size-regular text-color-secondary max-width-60ch\">Sixty characters, for body copy that runs longer than a paragraph and still has to stay readable.</div>"
        },
        {
          "type": "gap"
        },
        {
          "type": "html",
          "html": "<div class=\"spacer-medium\"></div><h3 class=\"heading-style-h5\">Aspect ratios</h3><div class=\"spacer-xsmall\"></div>"
        },
        {
          "type": "row",
          "spec": "<b>.aspect-ratio-square</b>1 / 1",
