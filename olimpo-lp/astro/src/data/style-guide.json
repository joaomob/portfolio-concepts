    {
      "className": "section_sizing",
      "id": "sizing",
      "blocks": [
        {
          "type": "header",
          "num": "05",
          "title": "Sizing"
        },
        {
          "type": "html",
          "html": "<p class=\"text-size-regular text-color-secondary max-width-60ch\">Containers are sized in <code>em</code>, so they widen with the root scale instead of\n    snapping. Reading measure is capped in <code>ch</code>, which counts characters rather\n    than pixels and holds at any root size.</p>"
        },
        {
          "type": "html",
          "html": "<div class=\"spacer-medium\"></div>"
        },
        {
          "type": "gap"
        },
        {
          "type": "html",
          "html": "<h3 class=\"heading-style-h5\">Containers</h3><div class=\"spacer-xsmall\"></div>"
        },
        {
          "type": "row",
          "spec": "<b>.container-large</b>80em",
          "body": "<div class=\"sg-box\" style=\"height:2.5em;width:100%\"></div>"
