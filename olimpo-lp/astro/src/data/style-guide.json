        {
          "type": "html",
          "html": "<div class=\"spacer-medium\"></div><h3 class=\"heading-style-h5\">Max widths</h3><div class=\"spacer-xsmall\"></div>"
        },
        {
          "type": "row",
          "spec": "<b>.max-width-xxsmall</b>16em",
          "body": "<div class=\"sg-box max-width-xxsmall\" style=\"height:1.5em\"></div>"
