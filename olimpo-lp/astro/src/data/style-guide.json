      "blocks": [
        {
          "type": "header",
          "num": "04",
          "title": "Spacing"
        },
        {
          "type": "html",
          "html": "<p class=\"text-size-regular text-color-secondary max-width-60ch\">Client First spacing is a combo: one direction class plus one size class. The direction\n    class zeroes the other three sides, so <code>margin-bottom margin-small</code> gives bottom\n    margin only. Never merge them, or editing the base stops reaching what already exists.</p>"
        },
        {
          "type": "html",
          "html": "<div class=\"spacer-medium\"></div>"
