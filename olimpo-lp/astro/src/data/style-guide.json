        {
          "type": "html",
          "html": "<div class=\"spacer-medium\"></div><h3 class=\"heading-style-h5\">Utilities</h3><div class=\"spacer-xsmall\"></div>"
        },
        {
          "type": "row",
          "spec": "<b>.overflow-hidden</b>",
          "body": "<div class=\"text-size-small text-color-secondary\">Clips anything past the box. On <code>page-wrapper</code> it stops horizontal scroll from motion.</div>"
        },
        {
          "type": "row",
          "spec": "<b>.z-index-1 / -2</b>",
          "body": "<div class=\"text-size-small text-color-secondary\">Sets position relative and lifts the element. Two levels only, on purpose.</div>"
        },
        {
          "type": "row",
          "spec": "<b>.pointer-events-none</b>",
          "body": "<div class=\"text-size-small text-color-secondary\">For decorative layers that must not eat a click.</div>"
        },
        {
          "type": "row",
          "spec": "<b>.hide</b>",
          "body": "<div class=\"text-size-small text-color-secondary\">Display none. Combine with a breakpoint in the Designer rather than making a variant class.</div>"
        }
      ]
