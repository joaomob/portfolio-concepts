        {
          "type": "row",
          "spec": "<b>.container-medium</b>60em",
          "body": "<div class=\"sg-box\" style=\"height:2.5em;width:75%\"></div>"
        },
        {
          "type": "row",
          "spec": "<b>.container-small</b>44em",
