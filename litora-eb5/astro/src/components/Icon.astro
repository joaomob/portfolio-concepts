---
// The two inline icons of the site, drawn from src/lib/icons.ts so the Next.js build draws the same paths.
import { chevron, logoMark } from '../lib/icons';
interface Props { name: 'logo' | 'chevron' }
const isLogo = Astro.props.name === 'logo';
const icon = isLogo ? logoMark : chevron;
---
{isLogo
  ? <svg class="logo_mark" xmlns="http://www.w3.org/2000/svg" viewBox={icon.viewBox} aria-hidden="true" focusable="false"><path d={icon.d} fill="currentColor" fill-rule="evenodd" /></svg>
  : <svg class="faq_icon" xmlns="http://www.w3.org/2000/svg" viewBox={icon.viewBox} aria-hidden="true" focusable="false"><path d={icon.d} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>}
