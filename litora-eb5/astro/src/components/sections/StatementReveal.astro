---
// One sentence whose words light up with the scroll (motion.ts, 3).
import type { ViewOf } from '../../lib/content';
interface Props { view: ViewOf<'statement-reveal'> }
const { view } = Astro.props;
---
<section class={`section_statement-reveal ${view.bgClass}`}>
  <div class="padding-global padding-section-large">
    <div class="container-small">
      <div class="statement-reveal_component">
        <p class="text-style-eyebrow text-color-secondary">{view.label}</p>
        <p class="heading-style-h2 text-style-statement" data-statement>{view.text}</p>
      </div>
    </div>
  </div>
</section>
