---
// The people who speak, as photo cards with their role.
import Keep from '../Keep.astro';
import PhotoCard from '../PhotoCard.astro';
import type { ViewOf } from '../../lib/content';
interface Props { view: ViewOf<'speakers'> }
const { view } = Astro.props;
---
<section class={`section_speakers ${view.bgClass}`} id="speakers">
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="speakers_layout">
        <div class="speakers_header" data-reveal>
          <h2><Keep text={view.heading} /></h2>
          {view.note && <p class="text-size-small text-color-secondary">{view.note}</p>}
        </div>
        <ul class="speakers_list" role="list">
          {view.items.map((item) => (
            <li class="speakers_item" data-reveal>
              <PhotoCard img={item.img} alt={item.imageAlt} focusClass="is-focus-top" sizes="(min-width: 992px) 26rem, (min-width: 768px) 50vw, 27rem" heading={item.name} role={item.role} text={item.text} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
