---
// What the webinar covers: numbered rows, each with a thumbnail that straightens with the scroll (motion.ts, 6).
import Keep from '../Keep.astro';
import type { ViewOf } from '../../lib/content';
interface Props { view: ViewOf<'topic-grid'> }
const { view } = Astro.props;
---
<section class={`section_topic-grid ${view.bgClass}`} id="topics" data-nav-theme="inverse">
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="topic-grid_header" data-reveal>
        <div class="topic-grid_heading">
          <h2><Keep text={view.heading} /></h2>
          {view.intro && <p class="text-size-large text-color-secondary">{view.intro}</p>}
        </div>
      </div>
      <ol class="topic-grid_list" role="list">
        {view.items.map((item) => (
          <li class="topic-row_component">
            <span class="topic-row_line is-bleed" aria-hidden="true" data-line></span>
            <span class="topic-row_number heading-style-h3" aria-hidden="true" data-reveal>{item.number}</span>
            <h3 class="topic-row_title" data-reveal><Keep text={item.heading} /></h3>
            <p class="topic-row_text text-color-secondary" data-reveal>{item.text}</p>
            <div class="topic-row_media"><img class="topic-row_image" data-topic-image src={item.img.src} width={item.img.width} height={item.img.height} alt={item.imageAlt} loading="lazy" decoding="async" /></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
